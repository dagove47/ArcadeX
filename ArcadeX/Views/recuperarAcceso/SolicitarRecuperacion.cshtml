@{
    Layout = "~/Views/Shared/_LayoutInitial.cshtml";
    ViewBag.Title = "Recuperar Acceso";
}
<main class="">
    <section class="regLog col">
        <h1 class="regLog-Title">Recuperar Acceso</h1>
        @if (ViewBag.msj != null)
        {
            <div class="alert alert-info" role="alert" style="text-align:center">
                @ViewBag.msj
            </div>
        }
        @using (Html.BeginForm("SolicitarRecuperacion", "RecuperarAcceso"))
        {
            <div class="input-group">
                <input type="email" name="email" class="form-control" placeholder="Correo Electrónico" required />
            </div>
            <div class="regLog-Submit mt-3">
                <button type="submit" class="btn btn-block">Enviar Correo de Recuperación</button>
            </div>
        }
        <p class="mt-3 mb-2 regLog-Options">
            <a href="@Url.Action("Iniciarsesion","Home")">Volver a Iniciar Sesión</a>
        </p>
    </section>
</main>