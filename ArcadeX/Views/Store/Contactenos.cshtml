
@{
    ViewBag.Title = "Contactenos";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}

<main class="regLogMain">
    <section class="regLog col">
        <h1 class="regLog-Title">Contáctenos</h1>
        <form id="form">
            <div class="input-group">
                <input class="form-control" name="newName" id="newName" placeholder="Nombre" type="text" value="" />
            </div>
            <div class="input-group">
                <input class="form-control" name="newEmail" id="newEmail" placeholder="Correo Electrónico" type="email" value="" />
            </div>
            <div class="input-group">
                <input class="form-control" name="newSubject" id="newSubject" placeholder="Asunto" type="text" value="" />
            </div>
            <div class="input-group">
                <textarea class="form-control" cols="20" name="newMessage" id="newMessage" placeholder="Mensaje" rows="5" value=>
                </textarea>
            </div>
            <div class="regLog-Submit mt-3">
                <button type="submit" class="btn btn-block">Enviar</button>
            </div>
        </form>
    </section>
</main>

<script>
    const body = document.getElementById("bodyStore");
    body.classList.add("bodyStoreRegLog")
</script>
