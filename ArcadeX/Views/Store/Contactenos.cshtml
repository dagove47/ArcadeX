
@{
    ViewBag.Title = "Contactenos";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}
<style>
    .contact-info {
        background-color: rgba(0, 0, 0, 0.7);
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

        .contact-info h2 {
            color: rgba(188, 19, 254, 0.5);
            margin: 16px 0;
            text-align: center;
        }

        .contact-info p {
            line-height: 1.6;
            color: #666;
        }

        .contact-info .info-item {
            padding: 25px 0;
        }

            .contact-info .info-item i {
                color: #007bff;
                margin-right: 10px;
            }

</style>
<main class="regLogMain">
    <section class="regLog col">
        <h1 class="regLog-Title">Contáctenos</h1>
        <div class="contact-info">
            <h2>Información de Contacto</h2>
            <div class="info-item">
                <i class="fas fa-map-marker-alt"></i>
                <strong>Dirección:</strong>
                1234 Calle Ficticia, Ciudad Imaginaria de Belén, Heredia, Costa Rica
            </div>
            <div class="info-item">
                <i class="fas fa-phone"></i>
                <strong>Teléfono:</strong>
                +(506) 1234-5678
            </div>
            <div class="info-item">
                <i class="fas fa-envelope"></i>
                <strong>Email:</strong>
                arcadex@arcadex.com
            </div>
        </div>
    </section>
</main>
<script>
    const body = document.getElementById("bodyStore");
    body.classList.add("bodyStoreRegLog");
</script>

