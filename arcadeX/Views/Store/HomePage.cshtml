@model List<arcadeX.Models.Game>

@{
    ViewBag.Title = "HomePage";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}

<main>
    <section class="row flex-lg-row-reverse align-items-center g-5 py-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="https://images.pexels.com/photos/3165335/pexels-photo-3165335.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" class="d-block mx-lg-auto img-fluid heroImage" alt="Bootstrap Themes" width="700" height="500" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold lh-1 mb-4 text-center"><span class="mainColor">Bienvenido!</span></h1>
            <p class="lead heroText text-center">Explora las novedades y recomendaciones personalizadas en ArcadeX. ¡No te pierdas nuestras ofertas exclusivas de esta semana!</p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-5">
                <button type="button" class="btn btn-lg px-4 me-md-2 herobtn" onclick="buscarCatalogo()">Explorar Catálogo</button>
            </div>
        </div>
    </section>
    <section class="homeIcons" id="homeIcons">
        <div class="homeIcons-box">
            <div class="homeIcons-circle">
                <i class="bi bi-controller"></i>
            </div>
            <div class="homeIcons-title mt-2"> Consolas</div>
        </div>
        <div class="homeIcons-box">
            <div class="homeIcons-circle">
                <i class="bi bi-stars"></i>
            </div>
            <div class="homeIcons-title mt-2"> Tecnología</div>
        </div>
        <div class="homeIcons-box">
            <div class="homeIcons-circle">
                <i class="bi bi-joystick"></i>
            </div>
            <div class="homeIcons-title mt-2"> Diversión</div>
        </div>
    </section>
    <section class="games-wrapper" id="games-wrapper">
        <div class="games-list-wrapper">
            <h2 class="p-3">Catálogo:</h2>
            <div class="d-flex p-3 mb-4">
                <input class="form-control me-2" id="search-Card" type="search" placeholder="Buscar videojuego"
                       aria-label="Search" data-search>
            </div>
            <div class="cards-list" id="cards-list" data-game-cards-container>
                @foreach (var game in Model)
                {
                    <div class="card bg-dark" style="width: 18rem;">
                        <img src="@game.Thumbnail" class="card-img-top" alt="game image">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3" data-title>@game.Title</h5>
                            <div class="subtitle-card col">
                                Genero: &nbsp;<p class="card-text" data-genre>@game.Genre</p>
                            </div>
                            <div class="subtitle-card col">
                                Plataforma: &nbsp;<p class="card-text" data-platform>@game.Platform</p>
                            </div>
                            <div class="subtitle-card col">
                                Compañía: &nbsp;<p class="card-text" data-publisher>@game.Publisher</p>
                            </div>
                            <div class="subtitle-card col">
                                Lanzamiento: &nbsp;<p class="card-text" data-release>@game.Release_Date</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</main>

<script>
    function buscarCatalogo() {
        document.getElementById("games-wrapper").scrollIntoView();
    }
</script>
